{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated executive account profile and workspace preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "activeRole": {
          "type": "string",
          "enum": ["owner", "finance", "operations", "sales"]
        },
        "preferredPeriod": {
          "type": "string",
          "minLength": 3,
          "maxLength": 16
        },
        "preferredBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "favoriteReportIds": {
          "type": "array",
          "description": "Up to 20 favorite report IDs"
        },
        "recentReportIds": {
          "type": "array",
          "description": "Up to 10 recent report IDs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "activeRole",
        "preferredPeriod",
        "preferredBranch",
        "favoriteReportIds",
        "recentReportIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly owner-only PII record isolated from workspace profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "EnterpriseWorkspace": {
      "title": "EnterpriseWorkspace",
      "description": "Shared enterprise workspace container for executive roles",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "createdByUid", "createdAt", "updatedAt"]
    },
    "WorkspaceDecision": {
      "title": "WorkspaceDecision",
      "description": "Shared enterprise decision case synced across executive roles",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stage": {
          "type": "string",
          "enum": [
            "detection",
            "verification",
            "diagnosis",
            "decision_design",
            "assignment_approval",
            "execution",
            "outcome_measurement"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "ownerRole": {
          "type": "string",
          "enum": ["owner", "finance", "operations", "commercial", "sales"]
        },
        "branchScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "detectedMetric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "baselineValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "currentValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "estimatedFinancialImpact": {
          "type": "number"
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["verified", "partial", "rejected"]
        },
        "diagnosisSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "epistemicLevel": {
          "type": "string",
          "enum": [
            "calculated_fact",
            "analytical_conclusion",
            "hypothesis",
            "recommendation",
            "execution_outcome"
          ]
        },
        "proposedAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requiresOwnerApproval": {
          "type": "boolean"
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["pending_review", "approved", "rejected", "not_required"]
        },
        "approvedBy": {
          "type": "string",
          "maxLength": 120
        },
        "dueDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "executionNotes": {
          "type": "array"
        },
        "outcomeMeasurement": {
          "type": "object",
          "description": "Optional post-execution outcome measurement record"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "createdByUid",
        "title",
        "category",
        "stage",
        "severity",
        "ownerRole",
        "branchScope",
        "period",
        "detectedMetric",
        "baselineValue",
        "currentValue",
        "estimatedFinancialImpact",
        "verificationStatus",
        "diagnosisSummary",
        "epistemicLevel",
        "proposedAction",
        "requiresOwnerApproval",
        "approvalStatus",
        "dueDate",
        "executionNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceAlertRule": {
      "title": "WorkspaceAlertRule",
      "description": "Shared proactive deviation threshold rule",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "metricKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "metricLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "unit": {
          "type": "string",
          "enum": ["م.د.ع", "%", "يوم"]
        },
        "comparator": {
          "type": "string",
          "enum": ["gt", "lt"]
        },
        "threshold": {
          "type": "number"
        },
        "enabled": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "enum": ["owner", "finance", "operations", "commercial", "sales"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "createdByUid",
        "metricKey",
        "metricLabel",
        "unit",
        "comparator",
        "threshold",
        "enabled",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceAlertState": {
      "title": "WorkspaceAlertState",
      "description": "Shared acknowledgement or escalation state for a deviation alert",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "alertKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["acknowledged", "escalated"]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "createdByUid",
        "alertKey",
        "status",
        "by",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceAuditLog": {
      "title": "WorkspaceAuditLog",
      "description": "Immutable enterprise governance audit log entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorRole": {
          "type": "string",
          "enum": ["owner", "finance", "operations", "commercial", "sales"]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
