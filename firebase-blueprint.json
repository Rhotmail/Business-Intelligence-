        "createdByUid",
        "actorRole",
        "action",
        "target",
        "detail",
        "createdAt"
      ]
    },
    "WorkspaceRolePermission": {
      "title": "WorkspaceRolePermission",
      "description": "Admin-managed custom division, branch, report, and capability permissions for executive roles",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["operations", "finance", "sales"]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roleTitleAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "allowedSections": {
          "type": "array",
          "description": "Allowed workspace division/section IDs"
        },
        "allowedBranches": {
          "type": "array",
          "description": "Allowed branch/department scopes"
        },
        "allowedReportCategories": {
          "type": "array",
          "description": "Allowed report category titles"
        },
        "canViewFinancialMargins": {
          "type": "boolean"
        },
        "canViewTrustVault": {
          "type": "boolean"
        },
        "canViewAuditLogs": {
          "type": "boolean"
        },
        "canRunAiAnalysis": {
          "type": "boolean"
        },
        "canExportReports": {
          "type": "boolean"
        },
        "canManageAlerts": {
          "type": "boolean"
        },
        "canResolveConflicts": {
          "type": "boolean"
        },
        "canCreateDecisions": {
          "type": "boolean"
        },
        "updatedByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "createdByUid",
        "roleTitleAr",
        "allowedSections",
        "allowedBranches",
        "allowedReportCategories",
        "canViewFinancialMargins",
        "canViewTrustVault",
        "canViewAuditLogs",
        "canRunAiAnalysis",
        "canExportReports",
        "canManageAlerts",
        "canResolveConflicts",
        "canCreateDecisions",
        "updatedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceBudgetPermission": {
      "title": "WorkspaceBudgetPermission",
      "description": "Finance Director controlled budget line-item access policy for Operations and Sales directors",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["operations", "sales"]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roleTitleAr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "allowedBudgetItems": {
          "type": "array",
          "description": "Allowlisted budget line-item IDs permitted for this director"
        },
        "strictControlEnabled": {
          "type": "boolean"
        },
        "updatedByRole": {
          "type": "string",
          "enum": ["finance", "owner"]
        },
        "updatedByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "createdByUid",
        "roleTitleAr",
        "allowedBudgetItems",
        "strictControlEnabled",
        "updatedByRole",
        "updatedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin marker document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Executive account workspace profile and report preferences owned by userId"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing executive account email"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/EnterpriseWorkspace" },
      "description": "Enterprise workspace root document"
    },
    "/workspaces/{workspaceId}/decisions/{decisionId}": {
      "schema": { "$ref": "#/entities/WorkspaceDecision" },
      "description": "Shared enterprise decision cases across executive roles"
    },
    "/workspaces/{workspaceId}/alertRules/{ruleId}": {
      "schema": { "$ref": "#/entities/WorkspaceAlertRule" },
      "description": "Shared proactive deviation alert rules"
    },
    "/workspaces/{workspaceId}/alertStates/{alertId}": {
      "schema": { "$ref": "#/entities/WorkspaceAlertState" },
      "description": "Shared alert acknowledgement and escalation records"
    },
    "/workspaces/{workspaceId}/workspaceLogs/{logId}": {
      "schema": { "$ref": "#/entities/WorkspaceAuditLog" },
      "description": "Immutable shared governance audit log records"
    },
    "/workspaces/{workspaceId}/rolePermissions/{roleId}": {
      "schema": { "$ref": "#/entities/WorkspaceRolePermission" },
      "description": "Admin-managed access control policies per executive role"
    },
    "/workspaces/{workspaceId}/budgetPermissions/{roleId}": {
      "schema": { "$ref": "#/entities/WorkspaceBudgetPermission" },
      "description": "Finance Director controlled budget line-item permissions for operations and sales"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin directory"
    }
  }
}
